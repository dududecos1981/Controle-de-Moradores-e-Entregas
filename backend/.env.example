# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - BACKEND API (NEON + NESTJS)
# ==============================================================================

# Servidor
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Conexão Neon Serverless PostgreSQL
# Exemplo Neon: postgresql://[user]:[password]@[ep-xyz-pooler.sa-east-1.aws.neon.tech]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_samplepassword@ep-sample-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_MAX_CONNECTIONS=20
DATABASE_SSL=true

# Autenticação JWT & Segurança
JWT_SECRET=super-secret-jwt-key-change-in-production-2026-secure
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production-2026
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Configuração de Upload e Armazenamento (local ou s3)
STORAGE_DRIVER=local
UPLOAD_DESTINATION=./uploads
UPLOAD_MAX_FILE_SIZE_MB=5
BASE_APP_URL=http://localhost:3000

# Configurações AWS S3 (Necessário apenas se STORAGE_DRIVER=s3)
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=portaria-entregas-storage
