# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - STACK 100% GRATUITO (FREE TIER)
# ==============================================================================

# Servidor API
NODE_ENV=production
PORT=3000
API_PREFIX=api

# 1. Banco de Dados PostgreSQL Gratuito (Neon Serverless ou Supabase)
# Crie gratuitamente em: https://neon.tech ou https://supabase.com
DATABASE_URL=postgresql://neondb_owner:npg_samplepassword@ep-sample-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_MAX_CONNECTIONS=20
DATABASE_SSL=true

# 2. Autenticação JWT (Zero Custo)
JWT_SECRET=super-secret-jwt-key-change-in-production-2026-secure
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production-2026
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# 3. Armazenamento e Uploads Gratuitos (Local WebP com Sharp ou Cloudinary/Supabase Free)
STORAGE_DRIVER=local
UPLOAD_DESTINATION=./uploads
UPLOAD_MAX_FILE_SIZE_MB=5
BASE_APP_URL=http://localhost:3000

# 4. Push Notifications Gratuitas (Web Push / Local Queue)
# Não necessita de plano pago do Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
