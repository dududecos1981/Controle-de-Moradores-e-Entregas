# ==============================================================================
# FRONTEND (Painel da Portaria) - Exemplo de Variáveis de Ambiente
# COPIE este arquivo para .env.local em desenvolvimento
# No Vercel: adicione estas variáveis em Project Settings > Environment Variables
# ==============================================================================

# 1. Chave de API do Google Gemini (para assistente de Comunicados com IA)
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=sua_chave_gemini_aqui

# 2. URL da API Backend (NestJS)
# Local: http://localhost:3000/api
# Produção: https://seu-backend.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api
